+static void __init hide_bl_lock_fdt(void)
+{
+#ifdef CONFIG_OF
+	void *fdt = initial_boot_params;
+	int node, len;
+	const char *state;
+
+	if (!fdt)
+		return;
+
+	node = fdt_path_offset(fdt, "/firmware/android");
+	if (node < 0)
+		return;
+
+	/* vbmeta_device_state: unlocked -> locked */
+	state = fdt_getprop(fdt, node, "vbmeta_device_state", &len);
+	if (state && len >= 7 && !strcmp(state, "unlocked")) {
+		((char *)state)[0] = 'l'; ((char *)state)[1] = 'o';
+		((char *)state)[2] = 'c'; ((char *)state)[3] = 'k';
+		((char *)state)[4] = 'e'; ((char *)state)[5] = 'd';
+		((char *)state)[6] = '\0'; ((char *)state)[7] = '\0';
+	}
+
+	/* verifiedbootstate: orange -> green */
+	state = fdt_getprop(fdt, node, "verifiedbootstate", &len);
+	if (state && len >= 6 && !strcmp(state, "orange")) {
+		((char *)state)[0] = 'g'; ((char *)state)[1] = 'r';
+		((char *)state)[2] = 'e'; ((char *)state)[3] = 'e';
+		((char *)state)[4] = 'n'; ((char *)state)[5] = '\0';
+	}
+
+	/* flash_locked: 0 -> 1 */
+	state = fdt_getprop(fdt, node, "flash_locked", &len);
+	if (state && len >= 1 && !strcmp(state, "0")) {
+		((char *)state)[0] = '1';
+	}
+#endif
+}
