@@ -30,6 +44,82 @@
 
 #define CREATE_TRACE_POINTS
 
+/* ========== 伪装系统日志核心逻辑 ========== */
+
+/* 需要过滤的敏感关键字列表 */
+static const char *sensitive_keywords[] = {
+    /* Bootloader 解锁状态 */
+    "androidboot.flash.locked=0",
+    "androidboot.vbmeta.device_state=unlocked",
+    "androidboot.verifiedbootstate=orange",
+    "androidboot.verifiedbootstate=yellow",
+    "veritymode=disabled",
+    "androidboot.veritymode=disabled",
+    /* Root/KSU 相关 */
+    "KernelSU",
+    "KSU",
+    "SukiSU",
+    "susfs",
+    "SUSFS",
+    "ksu",
+    "kernelsu",
+    /* 调试/开发标识 */
+    "-dirty",
+    "-maybe-dirty",
+    "test-keys",
+    "unlockable",
+    "oem_unlock",
+    /* 其他敏感信息 */
+    "magisk",
+    "Magisk",
+    "zygisk",
+    "Zygisk",
+    NULL
+};
+
+/* 需要过滤的敏感进程/模块名 */
+static const char *sensitive_processes[] = {
+    "KernelSU",
+    "ksud",
+    "sukisu",
+    "sukisud",
+    "magisk",
+    "magiskd",
+    "zygisk",
+    NULL
+};
+
+/* 检查字符串是否包含敏感关键字 */
+static bool contains_sensitive(const char *str)
+{
+    const char **keyword;
+
+    if (!str)
+        return false;
+
+    for (keyword = sensitive_keywords; *keyword; keyword++) {
+        if (strstr(str, *keyword))
+            return true;
+    }
+
+    return false;
+}
+
+/* 检查是否包含敏感进程名 */
+static bool contains_sensitive_process(const char *str)
+{
+    const char **proc;
+
+    if (!str)
+        return false;
+
+    for (proc = sensitive_processes; *proc; proc++) {
+        if (strstr(str, *proc))
+            return true;
+    }
+
+    return false;
+}
+
+#define LOG_FILTER_ENABLED 1
+
